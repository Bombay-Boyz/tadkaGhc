cabal-version:      3.0
name:                tadka-ghc
version:             0.1.0.0
synopsis:            Adapter for GHC's external JSON diagnostics protocol, projecting into Tadka.
description:
  tadka-ghc decodes GHC's -fdiagnostics-as-json protocol faithfully,
  captures any unstructured build output (panics, crashes, non-GHC
  failures) as honestly-labeled data rather than discarding it, and
  optionally projects both into Tadka's diagnostic model so Tadka's
  existing renderers can handle graphical, prose, and JSON output.
category:            Development, Compilers/Interpreters
license:             MPL-2.0
license-file:        LICENSE
maintainer:          TODO-REPLACE-ME <maintainer@example.com>
build-type:          Simple
-- The test-suite reads these by relative path, so they must ship in the
-- sdist. Cabal only allows a wildcard together with a file extension, so
-- there is one glob per extension used under test/fixtures; a fixture with
-- a NEW extension must be added here (the sdist file count catches a miss).
-- test/fixtures/build/none contains only a dotfile (the suite needs that
-- otherwise-empty directory to exist), so it is listed explicitly.
extra-source-files:
  test/fixtures/**/*.cabal
  test/fixtures/**/*.golden
  test/fixtures/**/*.json
  test/fixtures/**/*.project
  test/fixtures/**/*.txt
  test/fixtures/**/*.yaml
  test/fixtures/build/none/.gitkeep

source-repository head
  type:     git
  location: https://github.com/Bombay-Boyz/tadka-ghc

flag werror
  description: Enable -Werror. Off by default so a new GHC release
    adding one new warning can't break downstream installs (per
    cabal check's own guidance); CI turns this on explicitly.
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wincomplete-patterns -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wmissing-fields -Wredundant-constraints
  if flag(werror)
    ghc-options: -Werror

common extensions
  default-extensions:
    GADTs
    DataKinds
    KindSignatures
    StandaloneDeriving
    StrictData
    DerivingStrategies
    DeriveFunctor
    LambdaCase
    OverloadedStrings
    ScopedTypeVariables
    NamedFieldPuns
    TypeApplications
    BangPatterns
    EmptyDataDecls

-- tadka bound (spec Phase 10 / I-09): written and verified against
-- tadka-2.0.0.0 from Hackage. Public identifiers used by the library and
-- executable: Diagnostic(..), Severity(SevWarning, SevError), Ann,
-- Context(NoContext), mkContext, ContextError, Labeled(..),
-- LabelKind(Primary), mkNamedSource, SourceError, mkSpan, SpanBuildError,
-- Target(TGraphical, TNarratable, TJson), Config, defaultConfig,
-- withTarget, reportDiagnostic. The test-suite additionally uses
-- contextLabelStates, LabelOk, Narratable, SomeRenderer, selectRenderer
-- and render. Widen the upper bound only after a clean build and test run
-- against the new major version.

-- Core library: pure GHC adaptation, no process I/O (spec Phase 2, I-35).
library
  import:           warnings, extensions
  hs-source-dirs:   src
  exposed-modules:
    Tadka.GHCProtocol
    Tadka.GHCProtocol.Types
    Tadka.GHCProtocol.Schema
    Tadka.GHCProtocol.Decode
    Tadka.GHCProtocol.Span
    Tadka.GHCProtocol.Diagnostic
    Tadka.GHCProtocol.BuildTool
    Tadka.GHCProtocol.Opaque
    Tadka.GHCProtocol.Process
  build-depends:
      base            >=4.20      && <4.23
    , aeson           >=2.0       && <2.3
    , text            >=2.0.2     && <2.3
    , bytestring      >=0.10.12   && <0.14
    , containers      >=0.6       && <0.9
    , filepath        >=1.4       && <1.6
    , directory       >=1.3       && <1.5
    , prettyprinter   >=1.7       && <1.8
    , tadka           >=2.0.0.0   && <2.1
  default-language: Haskell2010

-- Process-execution component: the only place typed-process is a
-- dependency (spec Phase 6.4/I-35).
library tadka-ghc-process
  import:           warnings, extensions
  hs-source-dirs:   process
  exposed-modules:
    Tadka.GHCProtocol.Runner
  build-depends:
      base            >=4.20      && <4.23
    , tadka-ghc
    , typed-process   >=0.2       && <0.3
    , stm             >=2.5       && <2.7
    , time            >=1.9       && <1.16
    , bytestring      >=0.10.12   && <0.14
    , text            >=2.0.2     && <2.3
  default-language: Haskell2010

executable tadka-ghc
  import:           warnings, extensions
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      base            >=4.20      && <4.23
    , tadka-ghc
    , tadka-ghc-process
    , tadka           >=2.0.0.0   && <2.1
    , text            >=2.0.2     && <2.3
    , time            >=1.9       && <1.16
    , filepath        >=1.4       && <1.6
  default-language: Haskell2010

test-suite tadka-ghc-test
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
      base            >=4.20      && <4.23
    , tadka-ghc
    , tadka-ghc-process
    , tadka           >=2.0.0.0   && <2.1
    , prettyprinter   >=1.7       && <1.8
    , aeson           >=2.0       && <2.3
    , directory       >=1.3       && <1.5
    , filepath        >=1.4       && <1.6
    , bytestring      >=0.10.12   && <0.14
    , text            >=2.0.2     && <2.3
    , tasty
    , tasty-hedgehog
    , hedgehog
    , tasty-golden
    , tasty-hunit
  default-language: Haskell2010
